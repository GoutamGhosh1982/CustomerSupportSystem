{
  "Jwt": {
    "Issuer": "CustomerSupportSystem",
    "Audience": "CustomerSupportClients",
    "Secret": "ThisIsAVeryLongSecretKeyForJwtTokenGeneration2024!@#"
  },
  "ReverseProxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "ticket-route": {
        "ClusterId": "ticket-cluster",
        "Match": { "Path": "/api/tickets/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "response-route": {
        "ClusterId": "response-cluster",
        "Match": { "Path": "/api/responses/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "notifications-hub-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/hubs/{**catch-all}" }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user-svc": { "Address": "http://localhost:5004/" }
        }
      },
      "ticket-cluster": {
        "Destinations": {
          "ticket-svc": { "Address": "http://localhost:5001/" }
        }
      },
      "response-cluster": {
        "Destinations": {
          "response-svc": { "Address": "http://localhost:5002/" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-svc": { "Address": "http://localhost:5003/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
